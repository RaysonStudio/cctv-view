# EditorConfig is awesome: https://editorconfig.org
# 顶层配置：所有文件默认行为
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Kotlin 源文件
[*.{kt,kts}]
indent_size = 4
max_line_length = 120

# Gradle 构建脚本
[*.{gradle,gradle.kts}]
indent_size = 4

# XML 资源文件（Android 布局、值、清单等）
[*.xml]
indent_size = 4

# 版本目录 TOML
[*.toml]
indent_size = 2

# 属性文件
[*.properties]
indent_size = 2

# Markdown：保留尾部空格（两个空格表示软换行）
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# YAML 配置（CI、Issue 模板等）
[*.{yml,yaml}]
indent_size = 2

# Shell 脚本
[*.sh]
indent_size = 4

# Windows 批处理
[*.bat]
end_of_line = crlf
